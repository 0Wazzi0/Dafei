{
  "name": "dafei-win7-0317",
  "private": true,
  "version": "1.0.0",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "compile:electron": "tsc -p tsconfig.electron.json && node build-electron-main.cjs",
    "electron:dev": "npm run compile:electron && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "pack": "npm run build && npm run compile:electron && npx electron-builder --win portable --ia32"
  },
  "dependencies": {
    "vue": "3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^14.2.9",
    "electron-builder": "^26.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.daifei.dafei-win7-0317",

    "productName": "dafei-0831",

    "directories": {

      "output": "release/dafei-0831"

    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],

      "artifactName": "dafei-0831.exe"

    },
    "portable": {

      "artifactName": "dafei-0831.exe"

    }
  }
}