{
  "name": "dafei-win7-0317",
  "private": true,
  "version": "1.0.0",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:templates": "node scripts/check-templates.cjs",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --remote-debugging-port=9222\"",
    "pack": "npm run build && npm run compile:electron && npx electron-builder --win portable --ia32"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.5",
    "vue": "3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-dom": "^3.5.44",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^14.2.9",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.daifei.dafei-win7-0317",
    "productName": "dafei-1103",
    "directories": {
      "output": "release/${productName}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "images/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "artifactName": "${productName}.exe"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  }
}
